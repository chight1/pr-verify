{
  "name": "pr-verify",
  "version": "0.1.0",
  "private": true,
  "description": "Pull-request pipeline: a deterministic gate, then an evidence-bound Claude review.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ncc build build/main.js -o dist --minify --license licenses.txt && node scripts/normalize-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "precision": "tsc -p tsconfig.build.json && node build/precision-cli.js"
  },
  "dependencies": {
    "@actions/artifact": "^6.3.1",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
